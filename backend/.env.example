PORT=3000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Local development (docker compose up -d at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ferreteria?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/ferreteria?schema=public"

# Supabase (Project Settings > Database > Connection string)
# DATABASE_URL: transaction pooler, port 6543 (used by the app)
# DIRECT_URL:   session pooler, port 5432 (used by migrations; IPv4-compatible, works from Render)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Brevo transactional email (SMTP & API > API Keys)
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Ferretería Gastón"
