generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & auth ----------

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  sales               Sale[]
  stockMovements      StockMovement[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Catalog ----------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id           Int      @id @default(autoincrement())
  // Code printed on the Code 39 label, stored without the "*" delimiters (e.g. "00001")
  code         String   @unique
  description  String
  supplierCode String?
  supplierId   Int?
  categoryId   Int?
  costPrice    Decimal? @db.Decimal(12, 2)
  salePrice    Decimal  @default(0) @db.Decimal(12, 2)
  // Decimal because some products are sold by length or weight (meters, kg)
  stock        Decimal  @default(0) @db.Decimal(12, 3)
  minStock     Int      @default(5)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  category  Category?       @relation(fields: [categoryId], references: [id])
  movements StockMovement[]
  saleItems SaleItem[]

  @@index([categoryId])
  @@index([supplierId])
}

// ---------- Stock ----------

enum MovementType {
  INITIAL    // stock loaded from the original spreadsheet
  ENTRY      // restock / purchase
  SALE
  ADJUSTMENT // manual correction (breakage, physical count)
  RETURN     // cancelled sale
}

model StockMovement {
  id         Int          @id @default(autoincrement())
  productId  Int
  type       MovementType
  // Positive adds stock, negative removes it
  quantity   Decimal      @db.Decimal(12, 3)
  stockAfter Decimal      @db.Decimal(12, 3)
  note       String?
  userId     Int?
  saleId     Int?
  createdAt  DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])

  @@index([productId, createdAt])
  @@index([saleId])
}

// ---------- Sales ----------

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id          Int        @id @default(autoincrement())
  status      SaleStatus @default(COMPLETED)
  // Informative only (weekly report); products without a price count as 0
  total       Decimal    @db.Decimal(12, 2)
  userId      Int?
  createdAt   DateTime   @default(now())
  cancelledAt DateTime?

  user      User?           @relation(fields: [userId], references: [id])
  items     SaleItem[]
  movements StockMovement[]

  @@index([createdAt])
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int
  // Snapshots: past sales must not change when the product is edited later
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}
